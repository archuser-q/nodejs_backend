{
  "name": "thonhanh-backend",
  "version": "0.1.0",
  "description": "THỢ NHANH backend API (Node.js + Express + PostgreSQL with RLS)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "psql \"$DATABASE_OWNER_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_OWNER_URL\" -f db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
