# Kết nối dùng cho app Node.js — PHẢI dùng role thonhanh_app (không phải owner),
# nếu không RLS sẽ không có tác dụng.
DATABASE_URL=postgresql://thonhanh_app:change_me_app@localhost:5432/thonhanh

# Kết nối dùng riêng cho migration/seed (npm run db:migrate / db:seed), dùng
# role thonhanh_owner để có quyền tạo bảng/role.
DATABASE_OWNER_URL=postgresql://thonhanh_owner:change_me_owner@localhost:5432/thonhanh

PORT=3000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
